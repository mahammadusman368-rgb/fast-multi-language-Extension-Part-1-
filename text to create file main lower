-- Function: Clipboard mein text copy karne ke liye
local function copyToClipboard(text, successMsg)
  if text == "" then
    speakAndToast("Copy karne ke liye koi text nahi hai!")
    return
  end
  import "android.content.ClipData"
  local clipboard = service.getSystemService(Context.CLIPBOARD_SERVICE)
  local clip = ClipData.newPlainText("Copied Text", text)
  clipboard.setPrimaryClip(clip)
  speakAndToast(successMsg or "Text successfully copy ho gaya hai")
end

-- Function: Clipboard se text paste karne ke liye
-- FIXED: Ab koi extra character (newline waghera) khud se ADD nahi hota.
-- Jo bhi clipboard mein hai woh currentText ke bilkul peeche exact tareeqe se
-- jud jata hai -- taake bade code/text ko parts mein paste karne par
-- ek bhi character idhar-udhar na ho aur file 100% durust bane.
local function pasteFromClipboard(editText)
  import "android.content.ClipboardManager"
  local clipboard = service.getSystemService(Context.CLIPBOARD_SERVICE)
  if clipboard.hasPrimaryClip() then
    local item = clipboard.getPrimaryClip().getItemAt(0)
    local text = item.coerceToText(service)
    if text then
      local currentText = tostring(editText.getText())
      -- Exact concatenation -- koi extra "\n" ya space add nahi hota
      editText.setText(currentText .. tostring(text))
      speakAndToast("Text successfully paste aur append ho gaya hai")
      return
    end
  end
  speakAndToast("Clipboard mein koi text nahi hai!")
end

-- Universal safe file-reading function (har Android version 8 se 14+ ke liye)
local function readAllFromStream(fin)
  local chunks = {}
  local b = fin.read()
  while b ~= -1 do
    table.insert(chunks, string.char(b))
    b = fin.read()
  end
  fin.close()
  return table.concat(chunks)
end

local function readFileContentSafe(file)
  if not file.exists() then
    return nil
  end
  local ok, result = pcall(function()
    local fin = FileInputStream(file)
    return readAllFromStream(fin)
  end)
  if ok then
    return result
  else
    return nil
  end
end

-- Function: Direct File Sharing via Android Intent
-- FIXED: FileProvider is app mein available nahi hai (crash de raha tha),
-- isliye ab seedha Uri.fromFile use hota hai aur SAB kuch pcall ke andar hai
-- taake import fail hone par bhi extension crash na ho, sirf message aaye.
local function shareFile(filePath, fileName)
  local file = File(filePath)
  if not file.exists() then
    speakAndToast("Share karne ke liye file maujood nahi hai!")
    return
  end

  local ok = pcall(function()
    local uri = Uri.fromFile(file)

    local intent = Intent(Intent.ACTION_SEND)
    intent.setType("text/plain")
    intent.putExtra(Intent.EXTRA_STREAM, uri)
    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)

    local chooser = Intent.createChooser(intent, "Share File: " .. fileName)
    chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)

    service.startActivity(chooser)
  end)

  if ok then
    speakAndToast("Share menu open ho raha hai")
  else
    speakAndToast("Share karte waqt masla aaya, dobara koshish karein")
  end
end

-- Advanced Favorites Management (Saving Name + Content securely)
local function getFavoritesMap()
  local favs = {}
  local fFile = File(favDbPath)
  if fFile.exists() then
    local content = readFileContentSafe(fFile)
    if content then
      for name, text in content:gmatch("===([^\n]+)===\n(.-)\n===END===\n") do
        favs[name] = text
      end
    end
  end
  return favs
end

-- FIXED: "+" ko ".." se replace kiya hai (yehi favorite save na hone ka asal bug tha)
local function saveFavoritesMap(favs)
  local content = ""
  for name, text in pairs(favs) do
    content = content .. "===" .. name .. "===\n" .. text .. "\n===END===\n"
  end
  local fout = FileOutputStream(File(favDbPath))
  fout.write(String(content).getBytes())
  fout.close()
end

local function isFavorite(fileName)
  local favs = getFavoritesMap()
  return favs[fileName] ~= nil
end

-- Agar file pehle se favorite hai to sirf inform karega, dobara add/remove nahi karega
local function addToFavoriteWithCheck(fileName, fileContent)
  local favs = getFavoritesMap()
  if favs[fileName] then
    speakAndToast("Yeh file pehle se favorite list mein maujood hai")
    return
  end
  favs[fileName] = fileContent or ""
  saveFavoritesMap(favs)
  speakAndToast("Favorites mein add kar diya gaya hai")
end

-- Sirf Favorites list ke andar se remove karne ke liye
local function removeFromFavorites(fileName)
  local favs = getFavoritesMap()
  favs[fileName] = nil
  saveFavoritesMap(favs)
end

-- Rename hone par favorites database mein bhi naam update karna (agar favorite tha)
local function renameInFavorites(oldName, newName)
  local favs = getFavoritesMap()
  if favs[oldName] then
    local content = favs[oldName]
    favs[oldName] = nil
    favs[newName] = content
    saveFavoritesMap(favs)
  end
end

-- Purani temp_ files ko start hote hi clean karna
local function cleanupOldTempFiles()
  local files = dir.listFiles()
  if files then
    for i = 0, #files - 1 do
      if files[i].isFile() then
        local fName = files[i].getName()
        if fName:sub(1, 5) == "temp_" then
          files[i].delete()
        end
      end
    end
  end
end
