-- Function: TTS Voice Feedback aur Toast dono ek sath chalane ke liye
local function speakAndToast(msg)
  service.speak(msg)
  Toast.makeText(service, msg, Toast.LENGTH_SHORT).show()
end

-- Function: Clipboard mein text copy karne ke liye
local function copyToClipboard(text, successMsg)
  if text == "" then
    speakAndToast("Copy karne ke liye koi text nahi hai!")
    return
  end
  import "android.content.ClipData"
  local clipboard = service.getSystemService(Context.CLIPBOARD_SERVICE)
  local clip = ClipData.newPlainText("Copied Text", text)
  clipboard.setPrimaryClip(clip)
  speakAndToast(successMsg or "Text successfully copy ho gaya hai")
end

-- Table to reference views safely without index crashes
local views = {}

-- Function: File list menu dikhane ke liye
local function openFileListMenu()
  local listDlg = LuaDialog()
  listDlg.setTitle("Files List")
  
  local fileList = {}
  local files = dir.listFiles()
  
  if files then
    for i = 0, #files - 1 do
      if files[i].isFile() and files[i].getName():find("%.txt$") then
        table.insert(fileList, files[i].getName())
      end
    end
  end
  
  if #fileList == 0 then
    speakAndToast("Filhal koi file maujood nahi hai")
    return
  end
  
  local listLayout = {
    LinearLayout,
    orientation = "vertical",
    padding = "20dp",
    {
      ListView,
      id = "fileListView",
      layout_width = "fill",
      layout_height = "0dp",
      layout_weight = 1,
      choiceMode = ListView.CHOICE_MODE_SINGLE,
    },
    {
      LinearLayout,
      orientation = "horizontal",
      layout_width = "fill",
      gravity = "center",
      {
        Button,
        text = "View Text",
        layout_weight = 1,
        id = "viewBtn",
      },
      {
        Button,
        text = "Delete",
        layout_weight = 1,
        id = "deleteBtn",
      },
      {
        Button,
        text = "Go Back",
        layout_weight = 1,
        id = "backBtn",
      },
    }
  }
  
  local listViews = {}
  listDlg.setView(loadlayout(listLayout, listViews))
  
  local adapter = ArrayAdapter(service, android.R.layout.simple_list_item_single_choice, fileList)
  listViews.fileListView.Adapter = adapter
  
  local selectedPosition = -1
  listViews.fileListView.onItemClick = function(parent, view, position, id)
    selectedPosition = position
  end
  
  -- View Text Click Logic (Main menu ke boxes mein text load karega aur list close hogi)
  listViews.viewBtn.onClick = function()
    if selectedPosition == -1 then
      speakAndToast("Pehle list se koi file check karein")
      return
    end
    
    local fileName = fileList[selectedPosition + 1]
    local targetFile = File(folderPath .. fileName)
    
    local fileIn = FileInputStream(targetFile)
    local bytes = fileIn.readAllBytes()
    fileIn.close()
    local fileContent = String(bytes).toString()
    
    local cleanName = fileName:gsub("%.txt$", "")
    views.edtFileName.Text = cleanName
    views.edtTextContent.Text = fileContent
    
    speakAndToast("File ka text main menu mein load ho gaya hai")
    listDlg.dismiss()
  end
  
  -- Delete Button Click Logic with Confirmation Dialog Box
  listViews.deleteBtn.onClick = function()
    if selectedPosition == -1 then
      speakAndToast("Pehle delete karne ke liye file check karein")
      return
    end
    
    local fileName = fileList[selectedPosition + 1]
    local targetFile = File(folderPath .. fileName)
    
    local confirmDlg = LuaDialog()
    confirmDlg.setTitle("Delete Confirm?")
    
    local confirmLayout = {
      LinearLayout,
      orientation = "vertical",
      padding = "20dp",
      {
        TextView,
        text = "Kya aap waqai '" .. fileName .. "' ko delete karna chahte hain?",
        textSize = "16sp",
        layout_marginBottom = "20dp",
      },
      {
        LinearLayout,
        orientation = "horizontal",
        layout_width = "fill",
        gravity = "center",
        {
          Button,
          text = "Confirm Delete",
          layout_weight = 1,
          id = "btnRealDelete",
        },
        {
          Button,
          text = "Cancel",
          layout_weight = 1,
          id = "btnCancelDelete",
        },
      }
    }
    
    local confirmViews = {}
    confirmDlg.setView(loadlayout(confirmLayout, confirmViews))
    
    confirmViews.btnRealDelete.onClick = function()
      if targetFile.delete() then
        speakAndToast("File successfully delete kar di gai hai")
        confirmDlg.dismiss()
        listDlg.dismiss()
        openFileListMenu() -- List ko auto refresh karne ke liye
      else
        speakAndToast("File delete nahi ho saki")
        confirmDlg.dismiss()
      end
    end
    
    confirmViews.btnCancelDelete.onClick = function()
      speakAndToast("Delete cancel kar diya gaya")
      confirmDlg.dismiss()
    end
    
    confirmDlg.show()
  end
  
  listViews.backBtn.onClick = function()
    listDlg.dismiss()
  end
  
  listDlg.show()
end

