-- Setup Spinner Adapter for File Extensions/Categories (.txt, .lua, .html, .json, .js, .py, .css)
local extensionsList = {"txt", "lua", "html", "json", "js", "py", "css"}
local adapter = ArrayAdapter(service, android.R.layout.simple_spinner_item, extensionsList)
adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
views.spinnerExtension.setAdapter(adapter)

-- Accessibility First Focus Rule
views.txtHeaderTitle.requestFocus()
views.txtHeaderTitle.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)

-- Live Character & Word Counter Logic
views.edtTextContent.addTextChangedListener({
  onTextChanged = function(s, start, before, count)
    local textStr = tostring(s)
    local charCount = utf8 and utf8.len(textStr) or #textStr
    local wordCount = 0
    for w in textStr:gmatch("%S+") do
      wordCount = wordCount + 1
    end
    views.txtCounter.Text = "Characters: " .. charCount .. " | Words: " .. wordCount
  end
})

-- Copy Button Trigger
views.btnCopyText.onClick = function()
  local currentText = tostring(views.edtTextContent.Text)
  copyToClipboard(currentText, "Text successfully copy ho gaya hai")
end

-- Paste Button Trigger (Exact Append - no extra characters added)
views.btnPasteText.onClick = function()
  pasteFromClipboard(views.edtTextContent)
end

-- Create File Button Click Logic (With Overwrite Confirmation & Spinner Extension)
views.btnCreateFile.onClick = function()
  local fName = tostring(views.edtFileName.Text):gsub("^%s+", ""):gsub("%s+$", "")
  local fContent = tostring(views.edtTextContent.Text)

  if fName == "" then
    speakAndToast("Pehle file ka name add karein!")
    return
  end

  if fContent == "" then
    speakAndToast("Pehle text add karein!")
    return
  end

  local selectedExt = extensionsList[views.spinnerExtension.getSelectedItemPosition() + 1] or "txt"

  if not fName:find("%.%w+$") then
    fName = fName .. "." .. selectedExt
  end

  local newFile = File(folderPath .. fName)

  local function writeFile()
    local ok = pcall(function()
      local fileOut = FileOutputStream(newFile)
      fileOut.write(String(fContent).getBytes())
      fileOut.close()
    end)

    if ok then
      speakAndToast("File successfully create ho gayi hai")
      views.edtFileName.Text = ""
      views.edtTextContent.Text = ""
    else
      speakAndToast("File create karte waqt masla aaya")
    end
  end

  if newFile.exists() then
    -- Overwrite Confirmation Dialog
    local overwriteDlg = LuaDialog()
    overwriteDlg.setTitle("File Pehle Se Maujood Hai")

    local overwriteLayout = {
      LinearLayout,
      orientation = "vertical",
      padding = "20dp",
      {
        TextView,
        text = "'" .. fName .. "' naam se file pehle se maujood hai. Kya aap ise overwrite (replace) karna chahte hain?",
        textSize = "16sp",
        layout_marginBottom = "20dp",
      },
      {
        LinearLayout,
        orientation = "horizontal",
        layout_width = "fill",
        gravity = "center",
        {
          Button,
          text = "Overwrite",
          layout_weight = 1,
          id = "btnOverwrite",
        },
        {
          Button,
          text = "Cancel",
          layout_weight = 1,
          id = "btnCancelOverwrite",
        },
      }
    }

    local overwriteViews = {}
    overwriteDlg.setView(loadlayout(overwriteLayout, overwriteViews))

    overwriteViews.btnOverwrite.onClick = function()
      overwriteDlg.dismiss()
      writeFile()
    end

    overwriteViews.btnCancelOverwrite.onClick = function()
      speakAndToast("File create cancel kar di gayi")
      overwriteDlg.dismiss()
    end

    overwriteDlg.show()
  else
    writeFile()
  end
end

