    local d_layout = {
      LinearLayout, orientation="vertical", padding="10dp",
      {TextView, text="Name: "..itm.name, id="detail_title_tv", textSize="16sp", textColor="#2196F3"}, 
      {TextView, id="stats_tv", text="Chars: "..total_chars.." | Lines: "..total_lines, padding="5dp"}, {TextView, id="content_header_tv", text="Saved Data Content:", paddingTop="5dp"},
      {EditText, id="preview_ed", text=itm.script, layout_width="fill", minLines=5, maxLines=8, gravity="top", backgroundColor="#f5f5f5", padding="5dp"},
      {TextView, text=itm.is_fav and "⭐ Unstar" or "⭐ Star", id="fav_btn"}, {TextView, text="Edit Button", id="edit_btn_action"}, {TextView, text="Copy Button", id="cp_btn"}, {TextView, text="Share Button", id="sh_btn"}, {TextView, text="Delete Button", id="dl_btn"}, {TextView, text="Back Button", id="bk_btn"}}
    local d_view = loadlayout(d_layout)
    d_view.findViewById(detail_title_tv.id).setTypeface(Typeface.DEFAULT_BOLD)
    d_view.findViewById(content_header_tv.id).setTypeface(Typeface.DEFAULT_BOLD)
    d_view.findViewById(stats_tv.id).setTypeface(Typeface.defaultFromStyle(Typeface.ITALIC))
    local preview_view = d_view.findViewById(preview_ed.id)
    preview_view.setKeyListener(nil) preview_view.setFocusable(true)
    style_as_button(d_view.findViewById(fav_btn.id), "#FF9800")
    style_as_button(d_view.findViewById(edit_btn_action.id), "#2196F3")
    style_as_button(d_view.findViewById(cp_btn.id), "#009688")
    style_as_button(d_view.findViewById(sh_btn.id), "#4CAF50")
    style_as_button(d_view.findViewById(dl_btn.id), "#E91E63")
    style_as_button(d_view.findViewById(bk_btn.id), "#9E9E9E")
    local d_dlg = LuaDialog(service).setView(d_view)
    fav_btn.onClick = function() itm.is_fav = not itm.is_fav save_data(all_data) service.speak(itm.is_fav and "Star set" or "Unstar set") d_dlg.dismiss() l_dlg.dismiss() open_list_view_portal() end
    edit_btn_action.onClick = function() d_dlg.dismiss() l_dlg.dismiss() open_add_edit_dialog(idx, itm, function() open_list_view_portal() end) end
    cp_btn.onClick = function() service.setClip(itm.script) service.speak("Copy ho gaya") end
    sh_btn.onClick = function()
      d_dlg.dismiss() l_dlg.dismiss() main_dlg.dismiss()
      Handler().postDelayed(Runnable({run = function()
        local intent = Intent(Intent.ACTION_SEND).setType("text/plain")
        intent.putExtra(Intent.EXTRA_TEXT, tostring(itm.script))
        service.startActivity(Intent.createChooser(intent, "Share").setFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
      end}), 150)
    end
    dl_btn.onClick = function()
      local del_conf_layout = {LinearLayout, orientation="vertical", padding="15dp", layout_width="fill", {TextView, id="dc_title", text="Delete?", textSize="16sp", textColor="#2196F3", paddingBottom="10dp"}, {TextView, text="Kya aap isko delete karna chahte hain?", textSize="14sp", paddingBottom="15dp"}, {LinearLayout, layout_width="fill", orientation="horizontal", {TextView, text="Delete Button", id="dc_yes"}, {TextView, text="Cancel", id="dc_no"}}}
      local dc_view = loadlayout(del_conf_layout)
      dc_view.findViewById(dc_title.id).setTypeface(Typeface.DEFAULT_BOLD)
      style_as_button(dc_view.findViewById(dc_yes.id), "#F44336")
      style_as_button(dc_view.findViewById(dc_no.id), "#9E9E9E")
      local dc_dlg = LuaDialog(service).setView(dc_view)
      dc_yes.onClick = function() table.remove(all_data, idx) save_data(all_data) service.speak("Delete ho gaya") dc_dlg.dismiss() d_dlg.dismiss() l_dlg.dismiss() if last_selected_item_index > 0 then last_selected_item_index = last_selected_item_index - 1 end open_list_view_portal() end
      dc_no.onClick = function() dc_dlg.dismiss() end
