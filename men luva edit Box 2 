import_btn.onClick = function()
  local function show_browser(path)
    local files = {}
    local list = File(path).listFiles()
    if list then for i = 0, #list - 1 do table.insert(files, list[i].getName()) end end
    local b_layout = {
      LinearLayout, orientation="vertical", layout_width="fill",
      {TextView, text="Folder: "..path, padding="10dp"}, {ListView, id="flv", layout_width="fill", layout_weight=1},
      {LinearLayout, layout_width="fill", {TextView, text="Select File Button", id="done_btn"}, {TextView, text="Back Button", id="back_btn"}}}
    local browser_view = loadlayout(b_layout)
    style_as_button(browser_view.findViewById(done_btn.id), "#2196F3")
    style_as_button(browser_view.findViewById(back_btn.id), "#9E9E9E")
    local b_dlg = LuaDialog(service).setView(browser_view)
    flv.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, files))
    local sel_path = nil
    flv.onItemClick = function(l,v,p,i)
      local np = path.."/"..files[i+1]
      if File(np).isDirectory() then b_dlg.dismiss() show_browser(np) else sel_path = np service.speak("File select ho gayi") end
    end
    done_btn.onClick = function()
      if not sel_path then return end
      b_dlg.dismiss()
      local f = io.open(sel_path, "r")
      if f then
        local content = f:read("*a") f:close()
        local existing_name = check_duplicate_text(content)
        if existing_name then service.speak("Duplicate file hai") show_safe_alert("Duplicate!", "Is file ka data pehle se '"..existing_name.."' ke naam se save hai.") return end
        local edit_l = {LinearLayout, orientation="vertical", padding="15dp", {TextView, text="Yahan Naam Likhein:"}, {EditText, id="en", text=File(sel_path).getName(), layout_width="fill"}, {TextView, text="Save Data Button", id="save_imported"}}
        local edit_view = loadlayout(edit_l)
        style_as_button(edit_view.findViewById(save_imported.id), "#2196F3")
        local e_dlg = LuaDialog(service).setView(edit_view)
        save_imported.onClick = function()
          local d = load_data() table.insert(d, {name=en.getText().toString(), script=content, category="Other", date=get_custom_date(), is_fav=false}) save_data(d) service.speak("Save ho gaya") e_dlg.dismiss()
        end
        e_dlg.show()
      end
    end
    back_btn.onClick = function() b_dlg.dismiss() end
    b_dlg.show()
  end
  show_browser("/sdcard")
end

local function open_list_view_portal()
  local all_data = load_data()
  if #all_data == 0 then service.speak("List khali hai") return end
  local display_indices = {}
  for idx, item in ipairs(all_data) do table.insert(display_indices, {original_index = idx, data = item}) end
  table.sort(display_indices, function(a, b)
    if a.data.is_fav and not b.data.is_fav then return true end
    if not a.data.is_fav and b.data.is_fav then return false end
    return a.original_index < b.original_index
  end)
  local l_layout = {
    LinearLayout, orientation="vertical", layout_width="fill", padding="5dp",
    {EditText, id="search_bar", hint="Search Button", layout_width="fill", layout_margin="5dp"},
    {LinearLayout, layout_width="fill", orientation="horizontal", {TextView, text="Delete Button", id="multi_del_btn"}, {TextView, text="Refresh Button", id="refresh_list_btn"}},
    {ListView, id="lv", layout_width="fill", layout_weight=1}, {TextView, text="Back Button", id="lb"}}
  local l_view = loadlayout(l_layout)
  style_as_button(l_view.findViewById(multi_del_btn.id), "#E91E63")
  style_as_button(l_view.findViewById(refresh_list_btn.id), "#4CAF50")
  style_as_button(l_view.findViewById(lb.id), "#9E9E9E")
  local l_dlg = LuaDialog(service).setView(l_view)
  local function render_list(filter_text)
    local filtered_display = {}
    local display_strings = {}
    for _, wrapper in ipairs(display_indices) do
      local item = wrapper.data
      local matches_search = true
      if filter_text and filter_text ~= "" then matches_search = string.find(string.lower(item.name), string.lower(filter_text)) or string.find(string.lower(item.category or ""), string.lower(filter_text)) end
      if matches_search then
        table.insert(filtered_display, wrapper)
        local star_prefix = item.is_fav and "⭐ " or ""
        local date_tag = item.date and (" (" .. item.date .. ")") or ""
        table.insert(display_strings, star_prefix .. item.name .. date_tag)
      end
    end
    lv.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, display_strings))
    return filtered_display
  end
  local active_filtered_list = render_list("")
  if last_selected_item_index < #active_filtered_list then lv.setSelection(last_selected_item_index) end
  search_bar.addTextChangedListener(TextWatcher{onTextChanged=function(s, start, before, count) active_filtered_list = render_list(tostring(s)) end})
  refresh_list_btn.onClick = function() l_dlg.dismiss() open_list_view_portal() end
  multi_del_btn.onClick = function()
    if #active_filtered_list == 0 then return end
    local checked_items = {} local items_text = {}
    for i, wrapper in ipairs(active_filtered_list) do items_text[i] = wrapper.data.name checked_items[i] = false end
    local multi_del_layout = {LinearLayout, orientation="vertical", padding="15dp", layout_width="fill", {TextView, id="md_title", text="Delete Button", textSize="16sp", textColor="#2196F3", paddingBottom="10dp"}, {ListView, id="md_lv", layout_width="fill", layout_weight=1}, {LinearLayout, layout_width="fill", orientation="horizontal", paddingTop="10dp", {TextView, text="Confirm Delete", id="md_confirm_btn"}, {TextView, text="Close Button", id="md_cancel_btn"}}}
    local md_view = loadlayout(multi_del_layout)
    md_view.findViewById(md_title.id).setTypeface(Typeface.DEFAULT_BOLD)
    style_as_button(md_view.findViewById(md_confirm_btn.id), "#F44336")
    style_as_button(md_view.findViewById(md_cancel_btn.id), "#9E9E9E")
    local md_dlg = LuaDialog(service).setView(md_view)
    md_lv.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_multiple_choice, items_text))
    md_lv.setChoiceMode(ListView.CHOICE_MODE_MULTIPLE)
    md_lv.onItemClick = function(l,v,p,i) checked_items[i+1] = md_lv.isItemChecked(i) end
    md_confirm_btn.onClick = function()
      local delete_confirm_layout_final = {LinearLayout, orientation="vertical", padding="15dp", layout_width="fill", {TextView, id="cf_title", text="Confirm!", textSize="16sp", textColor="#2196F3", paddingBottom="10dp"}, {TextView, text="Kya aap chuni hui files delete karna chahte hain?", textSize="14sp", paddingBottom="15dp"}, {LinearLayout, layout_width="fill", orientation="horizontal", {TextView, text="Yes", id="cf_yes"}, {TextView, text="No", id="cf_no"}}}
      local dcf_view = loadlayout(delete_confirm_layout_final)
      dcf_view.findViewById(cf_title.id).setTypeface(Typeface.DEFAULT_BOLD)
      style_as_button(dcf_view.findViewById(cf_yes.id), "#F44336")
      style_as_button(dcf_view.findViewById(cf_no.id), "#9E9E9E")
      local cf_dlg = LuaDialog(service).setView(dcf_view)
      cf_yes.onClick = function()
        local fresh_all_data = load_data() local to_delete_indices = {}
        for k, checked in ipairs(checked_items) do if checked then table.insert(to_delete_indices, active_filtered_list[k].original_index) end end
        table.sort(to_delete_indices, function(a,b) return a > b end)
        for _, orig_idx in ipairs(to_delete_indices) do table.remove(fresh_all_data, orig_idx) end
        save_data(fresh_all_data) service.speak("Delete ho gaya") cf_dlg.dismiss() md_dlg.dismiss() l_dlg.dismiss()
        last_selected_item_index = 0 open_list_view_portal()
      end
      cf_no.onClick = function() cf_dlg.dismiss() end
      cf_dlg.show()
    end
    md_cancel_btn.onClick = function() md_dlg.dismiss() end
    md_dlg.show()
  end

  lv.onItemClick = function(l,v,p,i)
    last_selected_item_index = i
    local wrapper = active_filtered_list[i+1]
    local idx = wrapper.original_index
    local itm = all_data[idx]
    local total_chars = string.len(itm.script)
