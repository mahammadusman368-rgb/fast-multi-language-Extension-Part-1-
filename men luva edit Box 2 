-- ========== Optimized Save/Load System ==========
local function dump_value(val)
  if type(val) == "table" then
    local res = {"{\n"}
    for k, v in pairs(val) do
      if type(k) == "string" then
        table.insert(res, string.format("[%q]=%s,\n", k, dump_value(v)))
      else
        table.insert(res, string.format("[%d]=%s,\n", k, dump_value(v)))
      end
    end
    table.insert(res, "}")
    return table.concat(res)
  elseif type(val) == "string" then 
    return string.format("%q", val)
  else 
    return tostring(val) 
  end
end

local function save_data(data)
  local path = service.getFilesDir().toString().."/Data_Saver_Extension_Pro_Internal.dat"
  local f = io.open(path, "w")
  if f then
    f:write("return " .. dump_value(data))
    f:close()
    return true
  end
  return false
end

local function load_data()
  local path = service.getFilesDir().toString().."/Data_Saver_Extension_Pro_Internal.dat"
  local f = io.open(path, "r")
  if f then
    local content = f:read("*a")
    f:close()
    local chunk = load(content)
    if chunk then
      local ok, data = pcall(chunk)
      if ok and type(data) == "table" then return data end
    end
  end
  return {}
end

local function check_duplicate_text(new_text)
  local current_data = load_data()
  for _, item in ipairs(current_data) do
    if item.script == new_text then
      return item.name
    end
  end
  return nil
end

local function get_custom_date()
  local months = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
  local day = os.date("%d")
  local month_idx = tonumber(os.date("%m"))
  local year = os.date("%Y")
  return day .. " " .. months[month_idx] .. " " .. year
end

