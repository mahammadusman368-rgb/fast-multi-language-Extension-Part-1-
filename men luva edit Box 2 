local function check_duplicate_text(new_text)
  local current_data = load_data()
  for _, item in ipairs(current_data) do if item.script == new_text then return item.name end end
  return nil
end

local function get_custom_date()
  local months = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
  local day = os.date("%d")
  local month_idx = tonumber(os.date("%m"))
  local year = os.date("%Y")
  return day .. " " .. months[month_idx] .. " " .. year
end

