local function open_add_edit_dialog(edit_index, existing_item, on_close_callback)
  local is_edit = (edit_index ~= nil)
  local categories = {"Lua Script", "Text Note", "Important Key", "Other"}
  local al = {
    LinearLayout, orientation="vertical", layout_height="fill", layout_width="fill",
    {ScrollView, layout_weight=1, {LinearLayout, orientation="vertical", padding="15dp",
        {TextView, text="Select Category:"}, {Spinner, id="cat_spinner", layout_width="fill", layout_marginBottom="10dp"},
        {TextView, text="Yahan Naam Likhein:"}, {EditText, id="t", layout_width="fill", text = is_edit and existing_item.name or ""},
        {TextView, text="Yahan Data Paste Karen Ya Data Add Karen:"}, {EditText, id="c", layout_width="fill", minLines=10, gravity="top", text = is_edit and existing_item.script or ""}}},
    {LinearLayout, orientation="vertical", padding="10dp", {TextView, text=is_edit and "Update Data Button" or "Save Data Button", id="s"}, {TextView, text="Back Button", id="b"}}}
  local add_view = loadlayout(al)
  style_as_button(add_view.findViewById(s.id), "#2196F3")
  style_as_button(add_view.findViewById(b.id), "#9E9E9E")
  local ad = LuaDialog(service).setView(add_view)
  local spin_adapter = ArrayAdapter(service, android.R.layout.simple_spinner_item, categories)
  spin_adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
  cat_spinner.setAdapter(spin_adapter)
  if is_edit and existing_item.category then
    for idx, cat in ipairs(categories) do if cat == existing_item.category then cat_spinner.setSelection(idx-1) break end end
  end
  s.onClick = function()
    local title = t.getText().toString()
    local content = c.getText().toString()
    local selected_cat = categories[cat_spinner.getSelectedItemPosition() + 1]
    if title == "" or content == "" then service.speak("Naam aur Data likhna lazmi hai") return end
    if not is_edit or (is_edit and content ~= existing_item.script) then
      local existing_name = check_duplicate_text(content)
      if existing_name then service.speak("Yeh data pehle hi save hai") ad.dismiss() show_safe_alert("Warning!", "Yeh data pehle se '"..existing_name.."' ke naam se maujood hai.") return end
    end
    local d = load_data()
    if is_edit then d[edit_index] = {name = title, script = content, category = selected_cat, date = existing_item.date or get_custom_date(), is_fav = existing_item.is_fav or false} service.speak("Data update ho gaya")
    else table.insert(d, {name = title, script = content, category = selected_cat, date = get_custom_date(), is_fav = false}) service.speak("Data save ho gaya") end
    save_data(d) ad.dismiss() if on_close_callback then on_close_callback() end
  end
  b.onClick = function() ad.dismiss() if on_close_callback then on_close_callback() end end
  ad.show()
end

