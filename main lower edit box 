import "java.util.Locale"

-- 1. Initial Variables (Persistent from SharedData)
local savedLangCode = service.getSharedData("selectedLangCode")
local savedLangName = service.getSharedData("selectedLangName")

if savedLangCode and savedLangCode ~= "" then
  selectedLangCode = savedLangCode
else
  selectedLangCode = "ur-PK"
end

if savedLangName and savedLangName ~= "" then
  selectedLangName = savedLangName
else
  selectedLangName = "Urdu (Pakistan)"
end

-- 2. UNIVERSAL FOCUS FINDER (Stable for all Androids)
local function getUniversalFocus()
  local root = service.getRootInActiveWindow()
  if not root then return service.getEditText() end
  local focusedNode = root.findFocus(AccessibilityNodeInfo.FOCUS_INPUT)
  if focusedNode and (focusedNode.isEditable() or focusedNode.getClassName() == "android.widget.EditText") then
    return focusedNode
  end
  return service.getEditText()
end

-- 3. SMART MOOD-BASED EMOJI LOGIC
local function applySmartEmoji(text)
  if service.getSharedData("emoji_on") ~= "true" then return text end
  local t = text:lower()
  local emoji = ""
  
  if t:find("hah") or t:find("funny") or t:find("mazak") or t:find("hansi") or t:find("joke") then
    emoji = " 😂🤣😅"
  elseif t:find("sad") or t:find("rona") or t:find("dukh") or t:find("sorry") or t:find("gham") then
    emoji = " 😢😭💔"
  elseif t:find("love") or t:find("pyar") or t:find("ishq") or t:find("dil") or t:find("jan") then
    emoji = " ❤️😍💕"
  elseif t:find("gussa") or t:find("angry") or t:find("pagal") or t:find("bad") then
    emoji = " 😠🔥💢"
  elseif t:find("hi") or t:find("hello") or t:find("salam") or t:find("hey") or t:find("kaise") then
    emoji = " 👋😊🌸"
  elseif t:find("shukriya") or t:find("thanks") or t:find("meherbani") or t:find("jazakallah") then
    emoji = " 🙏😇✨"
  elseif t:find("khana") or t:find("food") or t:find("bhuk") or t:find("chai") or t:find("nashta") then
    emoji = " 🍽️☕🍲"
  elseif t:find("nind") or t:find("sleep") or t:find("night") or t:find("so gaya") then
    emoji = " 😴💤🌙"
  elseif t:find("ok") or t:find("theek") or t:find("done") or t:find("ji") then
    emoji = " ✅👍"
  elseif t:find("allah") or t:find("dua") or t:find("ameen") or t:find("mashallah") then
    emoji = " 🤲🕌😇"
  else
    emoji = " ✨"
  end
  
  return text .. emoji
end

-- 4. FIXED TONE PLAYER
local function playNotificationTone()
  if service.getSharedData("tone_on") == "true" then
    pcall(function()
      local uri = RingtoneManager.getDefaultUri(RingtoneManager.TYPE_NOTIFICATION)
      local r = RingtoneManager.getRingtone(service.getContext(), uri)
      if r then r.play() end
    end)
  end
end

-- 5. VOICE RECOGNITION ENGINE (Optimized Speed)
function startVoiceTyping(targetBox)
  pcall(function()
    if service.getSharedData("vibrate_on") == "true" then
      local vib = service.getContext().getSystemService(Context.VIBRATOR_SERVICE)
      if vib then vib.vibrate(60) end
    end
    
    playNotificationTone()

    local speechRec = SpeechRecognizer.createSpeechRecognizer(service.getContext())
    local listener = RecognitionListener {
      onResults = function(results)
        local resultsArray = results.getParcelableArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
        if resultsArray and resultsArray.size() > 0 then
          local spokenText = tostring(resultsArray.get(0))
          local finalText = applySmartEmoji(spokenText)
          service.insertText(targetBox, finalText .. " ")
          service.speak(spokenText)
        end
        speechRec.destroy()
        collectgarbage("collect")
      end,
      onError = function()
        service.asyncSpeak("Nahi samjha, dobara bole")
        speechRec.destroy()
      end,
    }
    
    local intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
    intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
    intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, selectedLangCode)
    intent.putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 1)
    
    speechRec.setRecognitionListener(listener)
    speechRec.startListening(intent)
  end)
end

-- 6. FULL SETTINGS MENU
function showSettingsMenu()
  local languages = {
    "English (US)",
    "Urdu (Pakistan)", "Punjabi (Pakistan)", "Sindhi (Pakistan)", "Pashto (Pakistan)", "Balochi (Pakistan)",
    "Urdu (India)", "Hindi (India)", "Bengali (India)", "Punjabi (India)", "Gujarati (India)", "Marathi (India)", "Tamil (India)", "Telugu (India)",
    "Bengali (Bangladesh)", "Arabic"
  }
  
  local codes = {
    "en-US", "ur-PK", "pa-PK", "sd-PK", "ps-PK", "bal-PK",
    "ur-IN", "hi-IN", "bn-IN", "pa-IN", "gu-IN", "mr-IN", "ta-IN", "te-IN",
    "bn-BD", "ar-SA"
  }

  local mainOptions = {
    "Language: "..selectedLangName,
    "Vibration: "..(service.getSharedData("vibrate_on") == "true" and "ON" or "OFF"),
    "Tone: "..(service.getSharedData("tone_on") == "true" and "ON" or "OFF"),
    "Smart Emoji: "..(service.getSharedData("emoji_on") == "true" and "ON" or "OFF"),
    "Contact Creator (WhatsApp)",
    "Go Back"
  }

  local builder = AlertDialog.Builder(service)
  builder.setTitle("Creator: Mohammad Usman")
  builder.setItems(mainOptions, function(dialog, which)
    if which == 0 then
      local lb = AlertDialog.Builder(service)
      lb.setTitle("Select Language")
      lb.setItems(languages, function(d, i)
        selectedLangCode, selectedLangName = codes[i+1], languages[i+1]
        -- Save permanently so it survives restart / service off-on
        service.setSharedData("selectedLangCode", selectedLangCode)
        service.setSharedData("selectedLangName", selectedLangName)
        service.speak("Set to " .. selectedLangName)
        showSettingsMenu()
      end)
      local ld = lb.create()
      ld.getWindow().setType(2032)
      ld.show()
    elseif which == 1 then
      service.setSharedData("vibrate_on", service.getSharedData("vibrate_on") == "true" and "false" or "true")
      showSettingsMenu()
    elseif which == 2 then
      service.setSharedData("tone_on", service.getSharedData("tone_on") == "true" and "false" or "true")
      showSettingsMenu()
    elseif which == 3 then
      service.setSharedData("emoji_on", service.getSharedData("emoji_on") == "true" and "false" or "true")
      showSettingsMenu()
    elseif which == 4 then
      service.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse("https://wa.me/923261421100")).setFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
    elseif which == 5 then
      dialog.dismiss()
    end
  end)
  
  local d = builder.create()
  d.getWindow().setType(2032)
  d.show()
end

-- 7. EXECUTION
pcall(function()
  local target = getUniversalFocus()
  if target then
    startVoiceTyping(target)
  else
    showSettingsMenu()
  end
end)